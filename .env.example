ANTHROPIC_API_KEY=your_anthropic_api_key_here
IRONHUB_API_KEY=your_ironhub_api_key_here
IRONHUB_API_URL=https://app.theironhub.com
SENDGRID_API_KEY=your_sendgrid_api_key_here
THOMAS_WEBHOOK_SECRET=your_shared_webhook_secret_here
# How long Thomas waits before emailing a buyer back, in milliseconds. Applied
# with +/-30% jitter. Defaults to 3 minutes; set to 0 to reply immediately.
# The role-play tool is never delayed.
THOMAS_REPLY_DELAY_MS=180000
PORT=3000
